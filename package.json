{
  "name": "playwright",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "node run-tests.js",
    "test:allure": "node run-tests.js --allure",
    "test:webtables": "node run-tests.js --tags @webtables",
    "test:droppable": "node run-tests.js --tags @droppable",
    "test:resizable": "node run-tests.js --tags @resizable",
    "test:form": "node run-tests.js --tags @practiceForm",
    "test:headed": "node run-tests.js --world-parameters '{\"headless\":false}'",
    "report": "node generate-report.js",
    "dashboard": "node dashboard/generate.js",
    "dashboard:open": "open reports/dashboard/index.html",
    "allure:generate": "allure generate allure-results --clean --single-file -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@cucumber/pretty-formatter": "^3.3.1",
    "@playwright/test": "^1.60.0",
    "allure-commandline": "^2.42.1",
    "allure-cucumberjs": "^3.10.0",
    "multiple-cucumber-html-reporter": "^3.10.0",
    "playwright": "^1.60.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
